{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/aso/collect-rankings?slot=1",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=2",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=3",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=4",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=5",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=6",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=7",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=8",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=9",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=10",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=11",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/aso/collect-rankings?slot=12",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/aso/collect-maintenance",
      "schedule": "30 20 * * *"
    }
  ],
  "functions": {
    "api/aso/collect.js": {
      "maxDuration": 300
    },
    "api/aso/collect-rankings.js": {
      "maxDuration": 300
    },
    "api/aso/collect-maintenance.js": {
      "maxDuration": 300
    }
  }
}
