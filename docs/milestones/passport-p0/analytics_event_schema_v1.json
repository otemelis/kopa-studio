{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PASSPORT consented detailed event v1 — proposed, disabled",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "install_id",
    "session_id",
    "event_name",
    "occurred_at",
    "app_version",
    "build_number",
    "build_channel",
    "device_layout",
    "screen_id",
    "control_id",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "install_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_name": {
      "type": "string",
      "enum": [
        "install_started",
        "session_started",
        "session_ended",
        "foreground_resumed",
        "screen_viewed",
        "control_activated",
        "onboarding_presented",
        "onboarding_completed",
        "stamp_editor_opened",
        "stamp_editor_cancelled",
        "stamp_created",
        "stamp_milestone_reached",
        "journey_opened",
        "bookmark_selected",
        "share_sheet_opened",
        "edition_viewed",
        "purchase_started",
        "purchase_completed",
        "restore_completed",
        "flight_import_picker_opened",
        "flight_import_file_selected",
        "flight_import_previewed",
        "flight_import_cancelled",
        "flight_import_failed",
        "flight_import_completed",
        "flight_import_undone",
        "discovery_feature_activated",
        "discovery_permission_result",
        "discovery_check_requested",
        "discovery_candidate_created",
        "discovery_candidate_suppressed",
        "discovery_inbox_opened",
        "discovery_suggestion_accepted",
        "discovery_suggestion_dismissed",
        "discovery_notification_scheduled",
        "discovery_notification_opened",
        "discovery_false_positive_reported"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "build_number": {
      "type": "string",
      "pattern": "^[0-9]{1,8}$"
    },
    "build_channel": {
      "enum": [
        "appstore",
        "testflight",
        "debug"
      ]
    },
    "device_layout": {
      "enum": [
        "regular",
        "folded",
        "unfolded",
        "unknown"
      ]
    },
    "screen_id": {
      "enum": [
        "app",
        "onboarding",
        "passport",
        "stamp_editor",
        "journey",
        "library",
        "flight_import",
        "atelier",
        "settings",
        "discovery",
        "unknown"
      ]
    },
    "control_id": {
      "enum": [
        "none",
        "add_stamp",
        "confirm_stamp",
        "cancel_stamp",
        "open_journey",
        "share",
        "choose_file",
